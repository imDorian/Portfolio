---
import Toggle from "./Toggle.astro";
---

<header class="w-auto flex justify-center items-center py-4 z-50 sticky top-0">
  <nav
    id="navHeader"
    class="w-full flex items-center justify-between flex-row gap-x-4 text-gray-300 text-sm md:text-xl px-4 py-3 rounded-full duration-[200ms]
     transition-all gap-10 border border-transparent"
  >
    <a class="hover:text-purple-500 hover:ease-in-out duration-300" href="/#top"
      >Inicio</a
    >
    <a
      class="hover:text-purple-500 hover:ease-in-out duration-300"
      href="/#contact">Contacto</a
    >
    <a
      class="hover:text-purple-500 hover:ease-in-out duration-300"
      href="/#projects">Proyectos</a
    >
    <!-- <a
      class="hover:text-purple-500 hover:ease-in-out duration-300 text-ellipsis overflow-hidden flex no-wrap"
      href="#about">Sobre mí</a
    > -->

    <!-- <Toggle />  -->
  </nav>
</header>
<script defer>
  document.addEventListener("scroll", () => {
    const nav = document.getElementById("navHeader");
    if (window.scrollY > 20) {
      nav.classList.remove("border-transparent");
      nav.classList.add(
        "bg-neutral-900",
        // "text-white",
        "font-semibold",
        "border-neutral-700",
      );
      // console.log("scrolling");
    } else {
      nav.classList.add("border-transparent");
      nav.classList.remove(
        "bg-neutral-900",
        "font-semibold",
        "border-neutral-700",
      );
      // console.log("not scrolling");
    }
  });
</script>
