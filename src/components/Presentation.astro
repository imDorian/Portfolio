---
import { Image } from "astro:assets";
import Badge from "./Badge.astro";
import Contact from "./Contact.astro";
import SocialPill from "./SocialPill.astro";
---

<section class="mx-auto py-1 flex flex-col items-start gap-7">
  <div class="flex flex-row gap-4 w-full">
    <Image
      id="dorian"
      loading="eager"
      src="/dorian.JPEG"
      height="120"
      width="120"
      alt="Dorian"
      class="rounded-full object-cover object-top opacity-90 w-32 h-32"
    />
    <div class="flex flex-col gap-4 items-start">
      <h1
        class="text-white text-4xl font-bold justify-center flex flex-row gap-x-5"
      >
        Hola, <br />
        soy Dorian
      </h1>
      <a
        href="https://linkedin.com/in/dorians-developer"
        target="_blank"
        rel="noopener"
        class="flex flex-row items-center"
      >
        <Badge>Disponible para trabajar</Badge>
      </a>
    </div>
  </div>
  <h3 class="text-2xl text-white opacity-80 prose prose-invert">
    +2 años de experiencia.
    <span class="text-purple-500 font-bold"
      >Desarrollador Web Full Stack y Deportista.</span
    >
    Vivo en Madrid, España 🇪🇸 y nacido en Rumanía 🇷🇴. Especializado en crear aplicaciones
    web únicas.
  </h3>
  <Contact />
</section>
