---
import GlobeIcon from "../../public/icons/GlobeIcon.astro";

const { title, description, link, image, slug } = Astro.props;
---

<div
  class="w-full md:h-[250px] flex flex-col dark:bg-neutral-800 rounded-3xl border-2 dark:border-neutral-600 shadow md:flex-row hover:shadow-inner hover:shadow-inner relative group"
>
  <div class="overflow-hidden rounded-3xl md:w-1/2">
    <a href=`/projects/${slug}` class="">
      <img
        class="rounded-3xl
       object-cover object-centeral
       w-full h-full
       transition-transform duration-500 ease-in-out transform group-hover:scale-110 group-hover:shadow-inner group-hover:shadow-2xl"
        src={image}
        alt={title}
      />
    </a>
  </div>

  <div class="p-5 md:w-1/2">
    <a href=`/projects/${slug}`>
      <h5
        class="mb-2 text-xl font-semibold tracking-tight text-gray-900 dark:text-white prose prose-invert"
      >
        {title}
      </h5>
    </a>
    <p class="mb-3 text-base font-normal prose prose-invert">
      {description}
    </p>
    <div class="flex flex-row gap-5 items-center justify-start">
      <a
        href=`/projects/${slug}`
        class="inline-flex items-center px-3 py-2 text-sm font-medium text-center dark:text-white dark:bg-purple-800 rounded-lg hover:bg-blue-800 focus:ring-4 focus:outline-none focus:ring-blue-300 dark:bg-blue-600 dark:hover:bg-blue-700 dark:focus:ring-blue-800"
      >
        Más detalles
        <svg
          class="rtl:rotate-180 w-3.5 h-3.5 ms-2"
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 14 10"
        >
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="2"
            d="M1 5h12m0 0L9 1m4 4L9 9"></path>
        </svg>
      </a>
      <a
        href=`${link}`
        target="_blank"
        class="bg-gradient-to-r from-cyan-500 to-blue-500 rounded-lg text-white px-3 py-2 text-sm inline-flex items-center gap-x-1.5"
      >
        Abrir App <GlobeIcon width="18px" />
      </a>
    </div>
  </div>
</div>
